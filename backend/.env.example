# Usuario y contraseña del panel /login
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# Secreto para firmar los tokens (usá algo largo y aleatorio en producción)
JWT_SECRET=cambiame-por-un-secreto-largo
JWT_EXPIRES_IN=7d

# Orígenes permitidos separados por coma, o "*" para cualquiera.
# Si se omite, se permite cualquier origen.
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

PORT=3000

# Opcionales: por defecto ./uploads y ./data dentro del contenedor
# UPLOAD_DIR=/app/uploads
# DATA_DIR=/app/data
