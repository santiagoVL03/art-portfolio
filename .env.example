# Copiá este archivo a .env para usarlo con docker compose.
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
JWT_SECRET=cambiame-por-un-secreto-largo

# Origen del front cuando corre con docker compose ("*" = cualquiera)
CORS_ORIGIN=http://localhost:5173

# URL de la API que el front usa en el build
VITE_API_URL=http://localhost:3000
